# Copy to .env.local for development. In production, set these in Vercel → Settings → Environment Variables.

# Public address of the site, used in email links.
NEXT_PUBLIC_SITE_URL=https://shoptafara.com

# Admin sign-in (until Supabase Auth). Use a long, unique password in production.
ADMIN_PASSWORD=
# Random string for signing the admin cookie: `openssl rand -hex 32`
ADMIN_SECRET=

# Supabase. Project Settings → API Keys. The secret key (sb_secret_…) is server-only: never prefix it NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token, only for `pnpm db:schema` / `pnpm db:sql` on a developer machine. Not needed on Vercel.
SUPABASE_ACCESS_TOKEN=

# "on" shows sample-order links on /track and "Reset demo data" in Settings. Remove before launch.
DEMO_DATA=

# Paystack (Phase 3). Settings → API Keys & Webhooks. Use test keys until launch.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Email via Resend. Verify the shoptafara.com domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM="Shop Tafara <orders@shoptafara.com>"

# Text messages via Termii (optional). The sender ID must be approved by Termii.
TERMII_API_KEY=
TERMII_SENDER_ID=ShopTafara
